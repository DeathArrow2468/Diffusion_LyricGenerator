# "demo" runs without a model; "model" loads your trained diffusion checkpoint.
LYRICWALA_MODE=demo
LYRICWALA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required only for model mode. Absolute paths are recommended (forward slashes on Windows).
LYRICWALA_REPO=C:/path/to/Diffusion_LyricGenerator
LYRICWALA_CHECKPOINT=C:/path/to/checkpoints/best_model.pt
# Folder containing tokenizer_config.json saved by tokenizer.save_pretrained(...).
LYRICWALA_TOKENIZER=C:/path/to/checkpoints
LYRICWALA_DEVICE=auto
LYRICWALA_STEPS=32
LYRICWALA_MIN_TIMESTEP=0.001
# Set to true ONLY for an old checkpoint with no saved tokenizer. Token definitions
# in training_4/config.py must exactly match those used during that training run.
LYRICWALA_ALLOW_LEGACY_TOKENIZER=false
# Old collator/sampler used a minimum timestep of 0.1; set the setting above to 0.1
# if serving that old checkpoint. Updated training uses 0.001.
